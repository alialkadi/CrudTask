{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/seriloglogs_.json",
          "rollingInterval": "Day"
        }
      }
    ]
      },
  "ConnectionStrings": {
    "DefaultConnection": "Server=.; Database=TaskCrud; Trusted_Connection=True; MultipleActiveResultSets=True; TrustServerCertificate=True"

  },

  "AllowedHosts": "*"
}
